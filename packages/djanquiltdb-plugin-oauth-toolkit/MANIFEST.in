# The sdist is what downstream packagers build and test from, so it carries the whole test project, not just the
# importable package. Without this, setuptools' defaults ship none of the fixture apps or settings the suite imports,
# and the suite in the sdist cannot run.
#
# The documentation is not here: docs/ lives at the repository root and covers the core library and the in-tree
# plugins together, so it cannot be grafted into either package. The Documentation URL points at it instead.

include CHANGELOG.rst
include LICENSE
include README.rst

graft tests

global-exclude *.py[cod]
global-exclude __pycache__
# A local test run leaves its coverage data in the test project; it is not part of the release.
global-exclude .coverage
global-exclude .coverage.*
